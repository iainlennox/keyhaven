@model MaintenanceFormModel
@{
    ViewData["Title"] = "Report a repair";
    var isTenant = User.IsInRole(Roles.Tenant);
}
<div class="page-header">
    <div>
        <div class="eyebrow">Maintenance</div>
        <h1 class="page-title">@(isTenant ? "Report a repair." : "Log a repair.")</h1>
        <p class="page-subtitle">Describe the issue. The assistant will triage the urgency and suggested trade, and the team takes it from there.</p>
    </div>
    <div class="page-actions"><a class="btn btn-outline" asp-action="Index">← Cancel</a></div>
</div>

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="split-even">
        <div class="card">
            <div class="card-header"><div><div class="card-title">The issue</div><div class="card-sub">What's happening and where</div></div></div>
            <div class="card-body">
                <div class="field">
                    <label asp-for="PropertyId">Property</label>
                    <select asp-for="PropertyId" asp-items="ViewBag.Properties"><option value="">Choose a property</option></select>
                    <span asp-validation-for="PropertyId" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Title">Short title</label>
                    <input asp-for="Title" placeholder="Leaking kitchen tap" />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Description">What's happening?</label>
                    <textarea asp-for="Description" rows="6" placeholder="Tell us what you've noticed, when it started and whether it's getting worse."></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>
            </div>
        </div>

        <div class="stack-md">
            <div class="card">
                <div class="card-header"><div><div class="card-title">Triage details</div><div class="card-sub">Helps us route the job</div></div></div>
                <div class="card-body">
                    <div class="form-grid">
                        <div class="field">
                            <label asp-for="Category">Category</label>
                            <select asp-for="Category" asp-items="Html.GetEnumSelectList<MaintenanceCategory>()"></select>
                        </div>
                        <div class="field">
                            <label asp-for="Urgency">How urgent is it?</label>
                            <select asp-for="Urgency" asp-items="Html.GetEnumSelectList<Urgency>()"></select>
                        </div>
                    </div>
                    <div class="field">
                        <label asp-for="AccessInstructions">Access instructions <span class="muted" style="text-transform:none;letter-spacing:0">(optional)</span></label>
                        <textarea asp-for="AccessInstructions" rows="3" placeholder="When someone can attend, keys, parking, pets…"></textarea>
                    </div>
                </div>
            </div>

            <div class="ai-panel">
                <div class="ai-head"><icon name="sparkles" /> What happens next</div>
                <div class="ai-title">Triaged on submission.</div>
                <div class="ai-text">The assistant reads the report for emergency signals, suggests an urgency and identifies the likely trade. A person confirms the plan and any appointment.</div>
            </div>
        </div>
    </div>

    <div class="card section-gap">
        <div class="card-footer">
            <div class="form-actions" style="margin:0;padding:0;border:0">
                <button class="btn btn-primary" type="submit">Log the repair</button>
                <a class="btn btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </div>
    </div>
</form>
