@model TenancyFormModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit tenancy" : "New tenancy";
}
<div class="page-header">
    <div>
        <div class="eyebrow">Lettings</div>
        <h1 class="page-title">@(isEdit ? "Edit tenancy" : "Create a tenancy")</h1>
        <p class="page-subtitle">Attach the tenant to the property, set the term, rent and deposit protection.</p>
    </div>
    <div class="page-actions"><a class="btn btn-outline" asp-action="Index">← Cancel</a></div>
</div>

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="split-even">
        <div class="card">
            <div class="card-header"><div><div class="card-title">Property & tenant</div><div class="card-sub">Who and where</div></div></div>
            <div class="card-body">
                <div class="field">
                    <label asp-for="PropertyId">Property</label>
                    <select asp-for="PropertyId" asp-items="ViewBag.Properties" data-rent-from-property="true"><option value="">Choose a property</option></select>
                    <span asp-validation-for="PropertyId" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="TenantId">Tenant</label>
                    <select asp-for="TenantId" asp-items="ViewBag.Tenants"><option value="">Choose a tenant</option></select>
                    <span asp-validation-for="TenantId" class="field-error"></span>
                </div>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="StartDate">Start date</label>
                        <input asp-for="StartDate" type="date" />
                        <span asp-validation-for="StartDate" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="EndDate">End date <span class="muted" style="text-transform:none;letter-spacing:0">(optional)</span></label>
                        <input asp-for="EndDate" type="date" />
                    </div>
                </div>
                <div class="callout info" style="margin-top:6px">
                    <icon name="doc" />
                    <div>Creating a tenancy marks the property as let and starts the first rent charge.</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><div><div class="card-title">Rent & deposit</div><div class="card-sub">The financial terms</div></div></div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="RentAmount">Rent (£ pcm)</label>
                        <input asp-for="RentAmount" id="RentAmount" type="number" step="0.01" min="0" />
                        <span asp-validation-for="RentAmount" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="DepositAmount">Deposit (£)</label>
                        <input asp-for="DepositAmount" type="number" step="0.01" min="0" />
                    </div>
                    <div class="field">
                        <label asp-for="DepositScheme">Deposit scheme</label>
                        <select asp-for="DepositScheme">
                            <option value="">Choose a scheme</option>
                            <option value="TDS">TDS</option>
                            <option value="DPS">DPS</option>
                            <option value="MyDeposits">MyDeposits</option>
                            <option value="SafeDeposits Scotland">SafeDeposits Scotland</option>
                        </select>
                    </div>
                    <div class="field" style="display:flex;align-items:flex-end">
                        <label class="checkbox"><input asp-for="DepositRegistered" /> Deposit already registered</label>
                    </div>
                </div>
                <div class="field">
                    <label asp-for="Notes">Notes</label>
                    <textarea asp-for="Notes" rows="4" placeholder="Anything the team should know about this tenancy."></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="card section-gap">
        <div class="card-footer">
            <div class="form-actions" style="margin:0;padding:0;border:0">
                <button class="btn btn-primary" type="submit">@(isEdit ? "Save changes" : "Create tenancy")</button>
                <a class="btn btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </div>
    </div>
</form>
