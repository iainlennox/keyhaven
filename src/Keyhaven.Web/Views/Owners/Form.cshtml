@model OwnerFormModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit owner" : "Add owner";
}
<div class="page-header">
    <div>
        <div class="eyebrow">Client relationships</div>
        <h1 class="page-title">@(isEdit ? $"Edit {Model.DisplayName}" : "Add an owner")</h1>
        <p class="page-subtitle">Capture the client relationship, management terms and onboarding stage.</p>
    </div>
    <div class="page-actions"><a class="btn btn-outline" asp-action="Index">← Cancel</a></div>
</div>

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="split-even">
        <div class="card">
            <div class="card-header"><div><div class="card-title">Owner details</div><div class="card-sub">Who the client is</div></div></div>
            <div class="card-body">
                <div class="field">
                    <label asp-for="DisplayName">Full name</label>
                    <input asp-for="DisplayName" placeholder="James Whitfield" />
                    <span asp-validation-for="DisplayName" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="CompanyName">Company <span class="muted" style="text-transform:none;letter-spacing:0">(optional)</span></label>
                    <input asp-for="CompanyName" placeholder="Whitfield Property Group" />
                </div>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" placeholder="owner@example.com" />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Phone">Phone</label>
                        <input asp-for="Phone" placeholder="07700 900000" />
                    </div>
                </div>
                <div class="field">
                    <label asp-for="Address">Address</label>
                    <input asp-for="Address" placeholder="41 Cleveden Road, Glasgow G12 0PH" />
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><div><div class="card-title">Management terms</div><div class="card-sub">Stage and commercial arrangement</div></div></div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="Status">Onboarding stage</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<OwnerStatus>()"></select>
                    </div>
                    <div class="field">
                        <label asp-for="ManagementFeePercent">Management fee (%)</label>
                        <input asp-for="ManagementFeePercent" type="number" step="0.5" min="0" max="30" />
                        <span asp-validation-for="ManagementFeePercent" class="field-error"></span>
                    </div>
                </div>
                <div class="field">
                    <label asp-for="Notes">Internal notes</label>
                    <textarea asp-for="Notes" rows="5" placeholder="Preferences, statement cadence, approval thresholds…"></textarea>
                </div>
                <div class="callout info">
                    <icon name="doc" />
                    <div>Agreement status is recorded separately, once the owner record exists.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card section-gap">
        <div class="card-footer">
            <div class="form-actions" style="margin:0;padding:0;border:0">
                <button class="btn btn-primary" type="submit">@(isEdit ? "Save changes" : "Add owner")</button>
                <a class="btn btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </div>
    </div>
</form>
