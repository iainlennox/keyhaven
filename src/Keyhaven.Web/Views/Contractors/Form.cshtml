@model ContractorFormModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit contractor" : "Add contractor";
}
<div class="page-header">
    <div>
        <div class="eyebrow">Contractor panel</div>
        <h1 class="page-title">@(isEdit ? $"Edit {Model.Name}" : "Add a contractor")</h1>
        <p class="page-subtitle">Trade, contact and compliance details for the people who carry out the work.</p>
    </div>
    <div class="page-actions"><a class="btn btn-outline" asp-action="Index">← Cancel</a></div>
</div>

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="card" style="max-width:820px">
        <div class="card-body">
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" placeholder="Dale Kerr" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Trade">Trade</label>
                    <input asp-for="Trade" placeholder="Plumbing & heating" />
                    <span asp-validation-for="Trade" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" placeholder="contractor@example.com" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Phone">Phone</label>
                    <input asp-for="Phone" placeholder="07700 900000" />
                </div>
                <div class="field">
                    <label asp-for="Rating">Rating (0–5)</label>
                    <input asp-for="Rating" type="number" step="0.1" min="0" max="5" />
                </div>
                <div class="field" style="display:flex;align-items:flex-end;gap:18px">
                    <label class="checkbox"><input asp-for="Insured" /> Insured</label>
                    <label class="checkbox"><input asp-for="Active" /> Active</label>
                </div>
                <div class="field span-2">
                    <label asp-for="Notes">Notes</label>
                    <textarea asp-for="Notes" rows="4" placeholder="Coverage, availability, key arrangements…"></textarea>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="form-actions" style="margin:0;padding:0;border:0">
                <button class="btn btn-primary" type="submit">@(isEdit ? "Save changes" : "Add contractor")</button>
                <a class="btn btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </div>
    </div>
</form>
