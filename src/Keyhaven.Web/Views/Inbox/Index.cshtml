@model InboxIndexViewModel
@{
    ViewData["Title"] = "AI inbox";
    var filters = new (string Key, string Label, int Count)[]
    {
        ("attention", "Needs attention", Model.NeedsAttention),
        ("drafts", "Drafts", Model.Drafts),
        ("auto", "Auto-replied", Model.AutoReplied),
        ("handled", "Handled", Model.HandledToday),
        ("all", "All", 0)
    };
}
<div class="page-header">
    <div>
        <div class="eyebrow">Relationships</div>
        <h1 class="page-title">The AI inbox.</h1>
        <p class="page-subtitle">Every message is classified, grounded in the record behind it, and either answered or handed to a person with a draft.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline" asp-controller="Enquiries" asp-action="Index"><icon name="inbox" /> Enquiries</a>
        <a class="btn btn-primary" asp-action="Compose"><icon name="plus" /> Simulate an email</a>
    </div>
</div>

<div class="ai-panel">
    <div class="row between wrap" style="gap:20px;align-items:flex-start">
        <div style="max-width:52ch">
            <div class="ai-head"><icon name="sparkles" /> Record-grounded replies</div>
            <div class="ai-title">The right answer starts with the right record.</div>
            <div class="ai-text">Routine questions with a complete supporting record can be answered automatically. Anything needing judgement becomes a draft. When a fact is missing, the reply says so rather than inventing it.</div>
        </div>
        <div class="grid-3" style="gap:24px;min-width:300px;flex:1">
            <div><div class="kicker">Waiting</div><div style="font-family:var(--serif);font-size:26px">@Model.NeedsAttention</div><div class="tiny muted">need a person</div></div>
            <div><div class="kicker">Drafts</div><div style="font-family:var(--serif);font-size:26px">@Model.Drafts</div><div class="tiny muted">ready to review</div></div>
            <div><div class="kicker">Auto-sent</div><div style="font-family:var(--serif);font-size:26px">@Model.AutoReplied</div><div class="tiny muted">grounded replies</div></div>
        </div>
    </div>
</div>

<div class="row between wrap section-gap" style="margin-bottom:14px">
    <div class="segmented">
        @foreach (var filter in filters)
        {
            <a class="@(Model.Filter == filter.Key ? "active" : "")" asp-action="Index" asp-route-filter="@filter.Key">@filter.Label@if (filter.Count > 0) { <span class="count">@filter.Count</span> }</a>
        }
    </div>
    <span class="small muted">Showing @Model.Messages.Count message@(Model.Messages.Count == 1 ? "" : "s")</span>
</div>

<div class="stack-sm">
    @if (Model.Messages.Count == 0)
    {
        <div class="card"><div class="empty"><div class="empty-icon"><icon name="check" /></div><div class="empty-title">Nothing waiting</div><div class="empty-text">The inbox is clear for this view.</div></div></div>
    }
    else
    {
        @foreach (var message in Model.Messages)
        {
            var tone = message.Confidence >= 90 ? "high" : message.Confidence >= 70 ? "mid" : "low";
            <a class="message-card @(message.Status is InboxStatus.New or InboxStatus.NeedsHuman ? "unread" : "")" asp-action="Details" asp-route-id="@message.Id">
                <div class="message-top">
                    <span class="avatar sm">@(message.FromName.Split(' ').Select(p => p[..1]).Aggregate("", (a, b) => a + b))</span>
                    <span class="message-from">@message.FromName</span>
                    <span class="badge badge-@message.Category.Tone()">@message.Category.Label()</span>
                    <span class="badge badge-@message.Status.Tone()">@message.Status.Label()</span>
                    <span class="message-meta">@message.ReceivedAt.Relative()</span>
                </div>
                <div class="message-subject">@message.Subject</div>
                <div class="message-preview">@message.Body</div>
                <div class="row between wrap" style="margin-top:10px;gap:10px">
                    <div class="row" style="gap:8px">
                        <span class="badge badge-@message.AutomationMode.Tone() no-dot">@message.AutomationMode.Label()</span>
                        @if (message.Confidence > 0)
                        {
                            <span class="confidence"><span class="meter"><span class="meter-fill @tone" style="width:@message.Confidence%"></span></span> @message.Confidence% confidence</span>
                        }
                    </div>
                    <span class="link-arrow">Open message <icon name="arrow-right" /></span>
                </div>
            </a>
        }
    }
</div>
