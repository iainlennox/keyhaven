{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "Keyhaven",
      "version": "1.0.0.0"
    }
  },
  "parameters": {
    "siteName": {
      "type": "string",
      "defaultValue": "[toLower(concat('keyhaven-', uniqueString(resourceGroup().id)))]",
      "minLength": 3,
      "maxLength": 60,
      "metadata": {
        "description": "Globally unique name for the Linux App Service. The URL will be https://<siteName>.azurewebsites.net."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the App Service plan and app."
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "S1"
      ],
      "metadata": {
        "description": "App Service plan size. B1 is the lowest useful tier for always-on hosting; S1 adds scale and deployment slots."
      }
    },
    "packageUri": {
      "type": "string",
      "defaultValue": "https://github.com/iainlennox/keyhaven/releases/latest/download/keyhaven-linux-x64.zip",
      "metadata": {
        "description": "Public URL to the published Linux x64 zip package. Defaults to the latest Keyhaven GitHub release asset."
      }
    }
  },
  "variables": {
    "planName": "[concat(parameters('siteName'), '-plan')]",
    "appSettings": [
      {
        "name": "ASPNETCORE_ENVIRONMENT",
        "value": "Production"
      },
      {
        "name": "ConnectionStrings__Default",
        "value": "Data Source=/home/keyhaven.db"
      },
      {
        "name": "WEBSITE_RUN_FROM_PACKAGE",
        "value": "[parameters('packageUri')]"
      },
      {
        "name": "ASPNETCORE_FORWARDEDHEADERS_ENABLED",
        "value": "true"
      },
      {
        "name": "ASPNETCORE_URLS",
        "value": "http://0.0.0.0:8080"
      },
      {
        "name": "WEBSITES_PORT",
        "value": "8080"
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('sku')]",
        "tier": "[if(equals(parameters('sku'), 'B1'), 'Basic', 'Standard')]",
        "capacity": 1
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('siteName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "siteConfig": {
          "linuxFxVersion": "DOTNETCORE|10.0",
          "alwaysOn": true,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "http20Enabled": true,
          "remoteDebuggingEnabled": false,
          "appSettings": "[variables('appSettings')]"
        }
      }
    }
  ],
  "outputs": {
    "appServiceName": {
      "type": "string",
      "value": "[parameters('siteName')]"
    },
    "appServiceUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('siteName'), '.azurewebsites.net')]"
    }
  }
}
